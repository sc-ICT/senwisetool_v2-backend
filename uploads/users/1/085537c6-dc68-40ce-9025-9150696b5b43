import { Agent, FormRequest } from "../types/agents.types";
import {
  FaBell,
  FaClipboardList,
  FaUsers,
  FaUserCheck,
} from "react-icons/fa6";

interface AgentStatsProps {
  agents: Agent[];
  requests: FormRequest[];
}

export function AgentStats({ agents, requests }: AgentStatsProps) {
  const total = agents.length;
  const active = agents.filter((a) => a.status === "ACTIVE").length;
  const totalForms = agents.reduce((s, a) => s + a.forms.length, 0);
  const pending = requests.length;

  const stats = [
    {
      label: "Total agents",
      value: total,
      icon: <FaUsers className="w-4 h-4" />,
      color: "text-zinc-100",
      iconBg: "bg-zinc-700/40 text-zinc-400",
      border: "border-white/8",
    },
    {
      label: "Agents actifs",
      value: active,
      icon: <FaUserCheck className="w-4 h-4" />,
      color: "text-emerald-300",
      iconBg: "bg-emerald-500/10 text-emerald-400",
      border: "border-emerald-500/15",
    },
    {
      label: "Formulaires assignés",
      value: totalForms,
      icon: <FaClipboardList className="w-4 h-4" />,
      color: "text-blue-300",
      iconBg: "bg-blue-500/10 text-blue-400",
      border: "border-blue-500/15",
    },
    {
      label: "Demandes en attente",
      value: pending,
      icon: <FaBell className="w-4 h-4" />,
      color: pending > 0 ? "text-amber-300" : "text-zinc-500",
      iconBg: pending > 0 ? "bg-amber-500/10 text-amber-400" : "bg-zinc-700/40 text-zinc-600",
      border: pending > 0 ? "border-amber-500/20" : "border-white/8",
    },
  ];

  return (
    <div className="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
      {stats.map((s) => (
        <div
          key={s.label}
          className={`relative rounded-xl border ${s.border} bg-[#0d1b35] px-4 py-4 overflow-hidden`}
        >
          {/* subtle grid bg */}
          <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(255,255,255,0.02),transparent_70%)]" />
          <div className="relative flex items-start justify-between gap-3">
            <div>
              <p className="text-xs text-zinc-600 mb-1.5">{s.label}</p>
              <p className={`text-2xl font-semibold tracking-tight ${s.color}`}>
                {s.value}
              </p>
            </div>
            <div className={`w-9 h-9 rounded-lg flex items-center justify-center shrink-0 ${s.iconBg}`}>
              {s.icon}
            </div>
          </div>
        </div>
      ))}
    </div>
  );
}
