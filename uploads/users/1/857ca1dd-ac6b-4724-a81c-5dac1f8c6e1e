"use client";

import { useState } from "react";
import { Agent, AssignedForm } from "../types/agents.types";
import { FormStatusBadge } from "../components/agents.atoms";
import {
  FaCheck,
  FaClipboardList,
  FaMagnifyingGlass,
  FaPlus,
  FaTrash,
} from "react-icons/fa6";

interface FormsModalProps {
  agent: Agent;
  isLoading: boolean;
  onClose: () => void;
  onAssign: (formId: string) => Promise<void>;
  onRemove: (agentFormId: string) => Promise<void>;
}

export function FormsModal({
  agent,
  isLoading,
  onClose,
  onAssign,
  onRemove,
}: FormsModalProps) {
  const [newFormId, setNewFormId] = useState("");
  const [removingId, setRemovingId] = useState<string | null>(null);
  const [assigning, setAssigning] = useState(false);
  const [filterSearch, setFilterSearch] = useState("");

  const visibleForms = agent.forms.filter(
    (f) =>
      !filterSearch ||
      f.code.toLowerCase().includes(filterSearch.toLowerCase()) ||
      f.name.toLowerCase().includes(filterSearch.toLowerCase()),
  );

  const handleAssign = async () => {
    const id = newFormId.trim();
    if (!id) return;
    setAssigning(true);
    await onAssign(id);
    setNewFormId("");
    setAssigning(false);
  };

  const handleRemove = async (agentFormId: string) => {
    setRemovingId(agentFormId);
    await onRemove(agentFormId);
    setRemovingId(null);
  };

  return (
    <div
      className="fixed inset-0 bg-black/60 flex items-center justify-center z-50 backdrop-blur-sm"
      onClick={onClose}
    >
      <div
        className="bg-[#0d1b35] border border-white/10 rounded-2xl w-[540px] max-w-[92vw] flex flex-col max-h-[85vh] shadow-2xl shadow-black/50"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Header */}
        <div className="flex items-center gap-3 px-6 py-5 border-b border-white/6 shrink-0">
          <div className="w-9 h-9 rounded-xl bg-blue-500/15 border border-blue-500/20 flex items-center justify-center">
            <FaClipboardList className="w-3.5 h-3.5 text-blue-400" />
          </div>
          <div className="flex-1 min-w-0">
            <h2 className="text-sm font-semibold text-zinc-100 truncate">
              Formulaires — {agent.agentName}
            </h2>
            <p className="text-xs text-zinc-600 mt-0.5">
              {agent.forms.length} formulaire{agent.forms.length > 1 ? "s" : ""} assigné{agent.forms.length > 1 ? "s" : ""}
            </p>
          </div>
          <button
            onClick={onClose}
            className="w-7 h-7 rounded-lg border border-white/8 text-zinc-500 hover:text-zinc-300 hover:bg-white/5 flex items-center justify-center transition-colors text-sm"
          >
            ✕
          </button>
        </div>

        {/* Assigner un formulaire */}
        <div className="px-6 pt-5 pb-4 border-b border-white/5 shrink-0">
          <p className="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-3">
            Assigner un formulaire
          </p>
          <div className="flex gap-2">
            <div className="relative flex-1">
              <FaPlus className="absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-600 pointer-events-none" />
              <input
                className="w-full h-9 pl-8 pr-3 text-sm rounded-xl border border-white/10 bg-white/5 text-zinc-100 font-mono placeholder-zinc-600 focus:outline-none focus:border-blue-500/40 focus:ring-1 focus:ring-blue-500/15 transition"
                placeholder="ID ou code du formulaire (ex: FORM-008)"
                value={newFormId}
                onChange={(e) => setNewFormId(e.target.value)}
                onKeyDown={(e) => e.key === "Enter" && handleAssign()}
              />
            </div>
            <button
              onClick={handleAssign}
              disabled={!newFormId.trim() || assigning || isLoading}
              className="h-9 px-4 text-sm rounded-xl bg-blue-600 text-white hover:bg-blue-500 disabled:opacity-40 disabled:cursor-not-allowed transition-colors flex items-center gap-2"
            >
              {assigning ? (
                <span className="w-3.5 h-3.5 border border-white/40 border-t-white rounded-full animate-spin" />
              ) : (
                <FaCheck className="w-3 h-3" />
              )}
              Assigner
            </button>
          </div>
        </div>

        {/* Liste formulaires assignés */}
        <div className="flex-1 overflow-y-auto px-6 py-4">
          {/* Recherche dans les formulaires */}
          {agent.forms.length > 3 && (
            <div className="relative mb-3">
              <FaMagnifyingGlass className="absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-600 pointer-events-none" />
              <input
                className="w-full h-8 pl-8 pr-3 text-xs rounded-lg border border-white/8 bg-white/3 text-zinc-300 placeholder-zinc-600 focus:outline-none focus:border-white/15"
                placeholder="Filtrer les formulaires..."
                value={filterSearch}
                onChange={(e) => setFilterSearch(e.target.value)}
              />
            </div>
          )}

          {agent.forms.length === 0 ? (
            <div className="flex flex-col items-center gap-3 py-10 text-center">
              <div className="w-10 h-10 rounded-full bg-white/3 border border-white/8 flex items-center justify-center">
                <FaClipboardList className="w-4 h-4 text-zinc-700" />
              </div>
              <p className="text-sm text-zinc-600">Aucun formulaire assigné à cet agent</p>
            </div>
          ) : (
            <div className="space-y-2">
              {visibleForms.map((f) => (
                <FormRow
                  key={f.id}
                  form={f}
                  isRemoving={removingId === f.id}
                  onRemove={() => handleRemove(f.id)}
                  disabled={isLoading}
                />
              ))}
              {visibleForms.length === 0 && filterSearch && (
                <p className="text-xs text-zinc-600 text-center py-4">
                  Aucun formulaire ne correspond à « {filterSearch} »
                </p>
              )}
            </div>
          )}
        </div>

        {/* Footer */}
        <div className="px-6 py-4 border-t border-white/6 shrink-0">
          <button
            onClick={onClose}
            className="h-9 px-4 text-sm rounded-xl border border-white/10 text-zinc-400 hover:bg-white/5 transition-colors"
          >
            Fermer
          </button>
        </div>
      </div>
    </div>
  );
}

// ─── Ligne formulaire ─────────────────────────────────────────────────────────

function FormRow({
  form,
  isRemoving,
  onRemove,
  disabled,
}: {
  form: AssignedForm;
  isRemoving: boolean;
  onRemove: () => void;
  disabled: boolean;
}) {
  return (
    <div className="flex items-center gap-3 px-4 py-3 rounded-xl border border-white/6 bg-white/2 hover:bg-white/4 transition-colors group">
      {/* Code */}
      <span className="font-mono text-xs bg-[#0a1628] border border-white/10 px-2 py-1 rounded-lg text-zinc-400 shrink-0">
        {form.code}
      </span>

      {/* Nom */}
      <span className="text-sm text-zinc-300 flex-1 truncate">{form.name}</span>

      {/* Statut */}
      <FormStatusBadge status={form.status} />

      {/* Stats enquêtes */}
      {form.downloaded && (
        <span className="text-xs text-zinc-500 shrink-0">
          <span className="text-emerald-400 font-medium">{form.surveyCount}</span> enquête{form.surveyCount > 1 ? "s" : ""}
        </span>
      )}

      {/* Retirer */}
      <button
        onClick={onRemove}
        disabled={isRemoving || disabled}
        className="w-7 h-7 rounded-lg border border-transparent text-zinc-700 hover:text-red-300 hover:bg-red-500/10 hover:border-red-500/20 flex items-center justify-center transition-colors opacity-0 group-hover:opacity-100 disabled:opacity-40"
        title="Retirer ce formulaire"
      >
        {isRemoving ? (
          <span className="w-3 h-3 border border-red-400/40 border-t-red-400 rounded-full animate-spin" />
        ) : (
          <FaTrash className="w-2.5 h-2.5" />
        )}
      </button>
    </div>
  );
}
