"use client";

import { useMemo, useState } from "react";
import { Agent, AgentStatus, AgentViewProps } from "./types/agents.types";
import { PER_PAGE } from "./components/agents.constants";
import { AgentStats } from "./components/agents.stats";
import { PendingRequestsPanel } from "./components/agents.requests-panel";
import { AgentToolbar } from "./components/agents.toolbar";
import { AgentsTable } from "./components/agents.table";
import { Pagination } from "./components/agents.pagination";
import { AgentModal } from "./modals/agent-create-edit.modal";
import { FormsModal } from "./modals/agent-forms.modal";
import { DeleteModal } from "./modals/agent-delete.modal";
import { DashLayout } from "@/ui/components/layout/dashLayout";
import { FaUserPlus } from "react-icons/fa6";

export const AgentsView = ({
  agents,
  requests,
  isLoading,
  agentsFetch,
  requestsFetch,
  onRetryAgents,
  onCreateAgents,
  onUpdateAgent,
  onDeleteAgents,
  onAssignForm,
  onRemoveForm,
  onReviewRequest,
  onBulkReviewRequests,
}: AgentViewProps) => {
  // ── UI state ───────────────────────────────────────────────────────────────
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState<"" | AgentStatus>("");
  const [sortBy, setSortBy] = useState<"name" | "date" | "forms">("name");
  const [sortDir, setSortDir] = useState<1 | -1>(1);
  const [page, setPage] = useState(1);
  const [selected, setSelected] = useState<Set<number>>(new Set());

  const [agentModal, setAgentModal] = useState<{
    open: boolean;
    agent: Partial<Agent> | null;
  }>({ open: false, agent: null });

  const [formsModal, setFormsModal] = useState<{
    open: boolean;
    agentId: number | null;
  }>({ open: false, agentId: null });

  const [deleteModal, setDeleteModal] = useState<{
    open: boolean;
    ids: number[];
    message: string;
  }>({ open: false, ids: [], message: "" });

  // ── Filtering & sorting ────────────────────────────────────────────────────
  const filtered = useMemo(() => {
    // Sécurité : agents peut être vide ou mal formé
    if (!Array.isArray(agents)) return [];
    const q = search.toLowerCase().trim();
    return agents
      .filter((a) => {
        if (!a) return false;
        const forms = Array.isArray(a.forms) ? a.forms : [];
        const matchQ =
          !q ||
          a.agentName?.toLowerCase().includes(q) ||
          a.token?.toLowerCase().includes(q) ||
          forms.some(
            (f) =>
              f?.code?.toLowerCase().includes(q) ||
              f?.name?.toLowerCase().includes(q),
          );
        return matchQ && (!statusFilter || a.status === statusFilter);
      })
      .sort((a, b) => {
        if (sortBy === "date") {
          const da = a.createdAt ? new Date(a.createdAt).getTime() : 0;
          const db = b.createdAt ? new Date(b.createdAt).getTime() : 0;
          return sortDir * (da - db);
        }
        if (sortBy === "forms") {
          const fa = Array.isArray(a.forms) ? a.forms.length : 0;
          const fb = Array.isArray(b.forms) ? b.forms.length : 0;
          return sortDir * (fb - fa);
        }
        return sortDir * (a.agentName ?? "").localeCompare(b.agentName ?? "");
      });
  }, [agents, search, statusFilter, sortBy, sortDir]);

  const totalPages = Math.ceil(filtered.length / PER_PAGE) || 1;
  const paginated = filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE);

  // ── Sort ───────────────────────────────────────────────────────────────────
  const handleSort = (col: "name" | "date" | "forms") => {
    if (sortBy === col) setSortDir((d) => (d === 1 ? -1 : 1));
    else { setSortBy(col); setSortDir(1); }
    setPage(1);
  };

  // ── Selection ──────────────────────────────────────────────────────────────
  const toggleSelect = (id: number) =>
    setSelected((prev) => {
      const n = new Set(prev);
      n.has(id) ? n.delete(id) : n.add(id);
      return n;
    });

  const toggleAll = (checked: boolean) =>
    setSelected(checked ? new Set(paginated.map((a) => a.id)) : new Set());

  const clearSelection = () => setSelected(new Set());

  // ── Agent CRUD ─────────────────────────────────────────────────────────────
  const handleSaveAgent = async (data: { agentNames: string[] }) => {
    if (agentModal.agent?.id) {
      await onUpdateAgent(agentModal.agent.id, { agentName: data.agentNames[0] });
    } else {
      await onCreateAgents({ agentNames: data.agentNames });
    }
    setAgentModal({ open: false, agent: null });
  };

  const openDelete = (ids: number[]) => {
    if (!ids.length) return;
    const names = agents
      .filter((a) => ids.includes(a.id))
      .map((a) => a.agentName ?? `Agent #${a.id}`);
    setDeleteModal({
      open: true,
      ids,
      message:
        ids.length === 1
          ? `Supprimer l'agent "${names[0]}" ? Cette action est irréversible.`
          : `Supprimer les ${ids.length} agents sélectionnés ? Cette action est irréversible.`,
    });
  };

  const confirmDelete = async () => {
    await onDeleteAgents(deleteModal.ids);
    setSelected((prev) => {
      const n = new Set(prev);
      deleteModal.ids.forEach((id) => n.delete(id));
      return n;
    });
    setDeleteModal({ open: false, ids: [], message: "" });
  };

  // ── Forms ──────────────────────────────────────────────────────────────────
  const formsAgent = agents.find((a) => a.id === formsModal.agentId) ?? null;

  // ── Requests ───────────────────────────────────────────────────────────────
  const bulkAcceptSelectedAgents = async () => {
    const targetIds = requests
      .filter((r) => selected.has(r.agentId))
      .map((r) => r.id);
    if (targetIds.length === 0) return;
    await onBulkReviewRequests({ requestIds: targetIds, action: "ACCEPT" });
  };

  const openAddAgent = () => setAgentModal({ open: true, agent: {} });

  return (
    <DashLayout className="min-h-screen text-zinc-100 p-6">
      <div className="max-w-7xl mx-auto">

        {/* ── Header ── */}
        <div className="flex items-start justify-between mb-6">
          <div>
            <h1 className="text-xl font-semibold text-zinc-100 tracking-tight">
              Agents
            </h1>
            <p className="text-sm text-zinc-600 mt-0.5">
              Gérez vos agents terrain et leurs formulaires assignés
            </p>
          </div>
          <button
            onClick={openAddAgent}
            className="h-9 px-4 text-sm rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-500 transition-colors flex items-center gap-2 shadow-lg shadow-blue-900/30"
          >
            <FaUserPlus className="w-3.5 h-3.5" />
            Ajouter un agent
          </button>
        </div>

        {/* ── Stats ── */}
        <AgentStats agents={agents} requests={requests} />

        {/* ── Demandes en attente ── */}
        {!requestsFetch.loading && !requestsFetch.hasError && (
          <PendingRequestsPanel
            requests={requests}
            onReview={onReviewRequest}
            onBulkReview={(ids, action) =>
              onBulkReviewRequests({ requestIds: ids, action })
            }
            isLoading={isLoading}
          />
        )}

        {/* ── Toolbar ── */}
        <AgentToolbar
          search={search}
          onSearch={(v) => { setSearch(v); setPage(1); }}
          statusFilter={statusFilter}
          onStatusFilter={(v) => { setStatusFilter(v); setPage(1); }}
          sortBy={sortBy}
          onSort={(v) => { setSortBy(v); setPage(1); }}
          selectedCount={selected.size}
          onBulkAccept={bulkAcceptSelectedAgents}
          onBulkDelete={() => openDelete([...selected])}
          onClearSelection={clearSelection}
        />

        {/* ── Table ── */}
        <AgentsTable
          agents={paginated}
          isLoading={agentsFetch.loading}
          hasError={agentsFetch.hasError}
          errorMessage={agentsFetch.errorMessage}
          onRetry={onRetryAgents}
          selected={selected}
          onToggleSelect={toggleSelect}
          onToggleAll={toggleAll}
          sortBy={sortBy}
          sortDir={sortDir}
          onSort={handleSort}
          onEdit={(agent) => setAgentModal({ open: true, agent })}
          onDelete={openDelete}
          onManageForms={(id) => setFormsModal({ open: true, agentId: id })}
          onAddAgent={openAddAgent}
        />

        {/* ── Pagination — masquée si erreur ou chargement ── */}
        {!agentsFetch.loading && !agentsFetch.hasError && filtered.length > 0 && (
          <Pagination
            page={page}
            totalPages={totalPages}
            total={filtered.length}
            perPage={PER_PAGE}
            onPage={setPage}
          />
        )}
      </div>

      {/* ── Modals ── */}
      {agentModal.open && (
        <AgentModal
          agent={agentModal.agent}
          isLoading={isLoading}
          onClose={() => setAgentModal({ open: false, agent: null })}
          onSave={handleSaveAgent}
        />
      )}

      {formsModal.open && formsAgent && (
        <FormsModal
          agent={formsAgent}
          isLoading={isLoading}
          onClose={() => setFormsModal({ open: false, agentId: null })}
          onAssign={(formId) => onAssignForm(formsAgent.id, { formId })}
          onRemove={(agentFormId) => onRemoveForm(formsAgent.id, agentFormId)}
        />
      )}

      {deleteModal.open && (
        <DeleteModal
          message={deleteModal.message}
          isLoading={isLoading}
          onCancel={() => setDeleteModal({ open: false, ids: [], message: "" })}
          onConfirm={confirmDelete}
        />
      )}
    </DashLayout>
  );
};
