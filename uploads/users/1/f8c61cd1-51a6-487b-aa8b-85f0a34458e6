"use client";

import { AgentStatus } from "../types/agents.types";
import { selectCls } from "./agents.constants";
import {
  FaArrowDownShortWide,
  FaCheck,
  FaMagnifyingGlass,
  FaTrash,
  FaXmark,
} from "react-icons/fa6";

interface AgentToolbarProps {
  search: string;
  onSearch: (v: string) => void;
  statusFilter: "" | AgentStatus;
  onStatusFilter: (v: "" | AgentStatus) => void;
  sortBy: "name" | "date" | "forms";
  onSort: (v: "name" | "date" | "forms") => void;
  selectedCount: number;
  onBulkAccept: () => void;
  onBulkDelete: () => void;
  onClearSelection: () => void;
}

export function AgentToolbar({
  search,
  onSearch,
  statusFilter,
  onStatusFilter,
  sortBy,
  onSort,
  selectedCount,
  onBulkAccept,
  onBulkDelete,
  onClearSelection,
}: AgentToolbarProps) {
  return (
    <div className="space-y-2 mb-4">
      {/* Ligne de recherche + filtres */}
      <div className="flex gap-2 flex-wrap">
        {/* Search */}
        <div className="relative flex-1 min-w-[220px]">
          <FaMagnifyingGlass className="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-600 pointer-events-none" />
          <input
            className="w-full h-9 pl-9 pr-3 text-sm rounded-lg border border-white/10 bg-[#0d1b35] text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-blue-500/40 focus:ring-1 focus:ring-blue-500/15 transition"
            placeholder="Rechercher par nom, token ou code formulaire..."
            value={search}
            onChange={(e) => onSearch(e.target.value)}
          />
        </div>

        {/* Statut */}
        <select
          className={selectCls}
          value={statusFilter}
          onChange={(e) => onStatusFilter(e.target.value as "" | AgentStatus)}
        >
          <option value="">Tous les statuts</option>
          <option value="ACTIVE">Actif</option>
          <option value="INACTIVE">Inactif</option>
        </select>

        {/* Tri */}
        <div className="relative">
          <FaArrowDownShortWide className="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-600 pointer-events-none" />
          <select
            className={`${selectCls} pl-8`}
            value={sortBy}
            onChange={(e) => onSort(e.target.value as typeof sortBy)}
          >
            <option value="name">Nom</option>
            <option value="date">Date de création</option>
            <option value="forms">Nb de formulaires</option>
          </select>
        </div>
      </div>

      {/* Bulk action bar — visible seulement si sélection */}
      {selectedCount > 0 && (
        <div className="flex items-center gap-3 px-4 py-2.5 rounded-xl border border-blue-500/20 bg-blue-500/5 backdrop-blur-sm">
          <div className="flex items-center gap-2 flex-1">
            <div className="w-5 h-5 rounded-md bg-blue-500/20 border border-blue-500/30 flex items-center justify-center">
              <FaCheck className="w-2.5 h-2.5 text-blue-400" />
            </div>
            <span className="text-sm font-medium text-blue-300">
              {selectedCount} agent{selectedCount > 1 ? "s" : ""} sélectionné{selectedCount > 1 ? "s" : ""}
            </span>
          </div>
          <div className="flex gap-2">
            <button
              onClick={onBulkAccept}
              className="h-7 px-3 text-xs font-medium rounded-lg border border-emerald-500/25 bg-emerald-500/10 text-emerald-300 hover:bg-emerald-500/20 transition-colors flex items-center gap-1.5"
            >
              <FaCheck className="w-2.5 h-2.5" />
              Accepter leurs demandes
            </button>
            <button
              onClick={onBulkDelete}
              className="h-7 px-3 text-xs font-medium rounded-lg border border-red-500/25 bg-red-500/10 text-red-300 hover:bg-red-500/20 transition-colors flex items-center gap-1.5"
            >
              <FaTrash className="w-2.5 h-2.5" />
              Supprimer
            </button>
            <button
              onClick={onClearSelection}
              className="h-7 px-2.5 text-xs rounded-lg border border-white/8 text-zinc-500 hover:bg-white/5 hover:text-zinc-400 transition-colors flex items-center gap-1"
            >
              <FaXmark className="w-2.5 h-2.5" />
              Annuler
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
