from pydantic import BaseModel, ConfigDict, Field

from app.models.form_builder.enums import FormulaireStatus


class FormulaireDefinitionCreate(BaseModel):
    name: str = Field(
        min_length=1,
        max_length=255,
    )

    description: str | None = None

    formulaire_type: str = Field(
        min_length=1,
        max_length=100,
    )


class FormulaireDefinitionUpdate(BaseModel):
    name: str | None = Field(
        default=None,
        min_length=1,
        max_length=255,
    )

    description: str | None = None

    formulaire_type: str | None = Field(
        default=None,
        min_length=1,
        max_length=100,
    )

    global_config: dict | None = None

    status: FormulaireStatus | None = None


class FormulaireDefinitionResponse(BaseModel):
    id: int
    code: str
    name: str
    description: str | None
    formulaire_type: str
    status: FormulaireStatus
    global_config: dict
    created_by: int
    formulaire_folder_id: int | None

    model_config = ConfigDict(
        from_attributes=True,
    )


class FormulaireDefinitionListResponse(BaseModel):
    items: list[FormulaireDefinitionResponse]
    count: int
