from __future__ import annotations

from datetime import datetime
from typing import TYPE_CHECKING

from sqlalchemy import (
    JSON,
    DateTime,
    ForeignKey,
    String,
    Text,
    func,
)
from sqlalchemy.orm import (
    Mapped,
    mapped_column,
    relationship,
)

from app.database import Base

if TYPE_CHECKING:
    from app.models.form_builder.formulaire_definition import FormulaireDefinition
    from app.models.form_builder.formulaire_question import FormulaireQuestion


class FormulaireSection(Base):
    __tablename__ = "formulaire_sections"

    id: Mapped[int] = mapped_column(
        primary_key=True,
    )

    formulaire_id: Mapped[int] = mapped_column(
        ForeignKey(
            "formulaire_definitions.id",
            ondelete="CASCADE",
        ),
        nullable=False,
        index=True,
    )

    name: Mapped[str] = mapped_column(
        String(255),
        nullable=False,
    )

    description: Mapped[str | None] = mapped_column(
        Text,
        nullable=True,
    )

    position: Mapped[int] = mapped_column(
        nullable=False,
        default=0,
    )

    config: Mapped[dict] = mapped_column(
        JSON,
        nullable=False,
        default=dict,
    )

    created_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        server_default=func.now(),
        nullable=False,
    )

    updated_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        server_default=func.now(),
        onupdate=func.now(),
        nullable=False,
    )

    formulaire: Mapped["FormulaireDefinition"] = relationship(
        "FormulaireDefinition",
        back_populates="sections",
        lazy="raise",
    )

    questions: Mapped[list["FormulaireQuestion"]] = relationship(
        "FormulaireQuestion",
        back_populates="section",
        cascade="all, delete-orphan",
        order_by="FormulaireQuestion.position",
        lazy="selectin",
    )
