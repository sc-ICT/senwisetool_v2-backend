    formulaire_id: int,
    section_id: int,
    formulaire_question_id: int,
    data: FormulaireQuestionUpdate,
    service: FormulaireQuestionService = Depends(
        get_formulaire_question_service,
    ),
    user: User = CurrentUser,
):
    try:
        formulaire_question = await service.update(
            formulaire_id=formulaire_id,
            section_id=section_id,
            formulaire_question_id=formulaire_question_id,
            user_id=user.id,
            data=data,
        )

        return ok(
            message="Question du formulaire modifiée.",
            data=build_formulaire_question_response(formulaire_question),
        )

    except ValueError as exc:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=str(exc),
        ) from exc


@router.delete(
    "/{formulaire_question_id}",
    response_model=ApiResponse[None],
)
async def delete_formulaire_question(
    formulaire_id: int,
    section_id: int,
    formulaire_question_id: int,
    service: FormulaireQuestionService = Depends(
        get_formulaire_question_service,
    ),
    user: User = CurrentUser,
):
    try:
        await service.delete(
            formulaire_id=formulaire_id,
            section_id=section_id,
            formulaire_question_id=formulaire_question_id,
            user_id=user.id,
        )

        return ok(
            message="Question retirée du formulaire.",
            data=None,
        )

    except ValueError as exc:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=str(exc),
        ) from exc
