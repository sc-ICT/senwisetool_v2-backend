from pydantic import BaseModel, Field


class FormulaireQuestionValidationConfig(BaseModel):
    required: bool = False

    min_value: float | None = None
    max_value: float | None = None

    min_length: int | None = Field(
        default=None,
        ge=0,
    )

    max_length: int | None = Field(
        default=None,
        ge=0,
    )

    default_value: str | list[str] | None = None


class FormulaireQuestionDisplayConfig(BaseModel):
    visible: bool = True
    readonly: bool = False

    placeholder: str | None = None
    help_text: str | None = None


class FormulaireQuestionConfig(BaseModel):
    validation: FormulaireQuestionValidationConfig = Field(
        default_factory=FormulaireQuestionValidationConfig,
    )

    display: FormulaireQuestionDisplayConfig = Field(
        default_factory=FormulaireQuestionDisplayConfig,
    )
