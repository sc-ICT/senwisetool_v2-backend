"use client";

import { FormRequest } from "../types/agents.types";
import { Avatar } from "./agents.atoms";
import { formatDate } from "./agents.constants";
import {
  FaBell,
  FaCheck,
  FaCheckDouble,
  FaChevronDown,
  FaChevronUp,
  FaXmark,
} from "react-icons/fa6";
import { useState } from "react";

interface PendingRequestsPanelProps {
  requests: FormRequest[];
  onReview: (requestId: string, action: "ACCEPT" | "REJECT") => Promise<void>;
  onBulkReview: (ids: string[], action: "ACCEPT" | "REJECT") => Promise<void>;
  isLoading: boolean;
}

export function PendingRequestsPanel({
  requests,
  onReview,
  onBulkReview,
  isLoading,
}: PendingRequestsPanelProps) {
  const [expanded, setExpanded] = useState(true);
  const [processingId, setProcessingId] = useState<string | null>(null);

  if (requests.length === 0) return null;

  const handleReview = async (id: string, action: "ACCEPT" | "REJECT") => {
    setProcessingId(id);
    await onReview(id, action);
    setProcessingId(null);
  };

  const handleBulkReview = async (action: "ACCEPT" | "REJECT") => {
    await onBulkReview(requests.map((r) => r.id), action);
  };

  return (
    <div className="relative mb-6">
      {/* Glow effect derrière le panneau */}
      <div className="absolute -inset-[1px] rounded-2xl bg-gradient-to-r from-amber-500/20 via-orange-500/10 to-amber-500/20 blur-sm pointer-events-none" />

      <div className="relative rounded-2xl border border-amber-500/30 bg-[#0f1c2e] overflow-hidden">
        {/* Bande supérieure colorée */}
        <div className="h-1 w-full bg-gradient-to-r from-amber-400 via-orange-400 to-amber-400" />

        {/* Header du panneau */}
        <div className="flex items-center gap-3 px-5 py-4">
          {/* Icône avec badge pulsé */}
          <div className="relative shrink-0">
            <div className="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/25 flex items-center justify-center">
              <FaBell className="w-4 h-4 text-amber-400" />
            </div>
            <span className="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-amber-500 text-[10px] font-bold text-black flex items-center justify-center shadow-lg shadow-amber-500/40 animate-bounce">
              {requests.length}
            </span>
          </div>

          {/* Texte */}
          <div className="flex-1 min-w-0">
            <p className="text-sm font-semibold text-amber-200 leading-tight">
              {requests.length} demande{requests.length > 1 ? "s" : ""} d'accès en attente
            </p>
            <p className="text-xs text-amber-500/70 mt-0.5">
              Des agents ont demandé l'accès à des formulaires non assignés
            </p>
          </div>

          {/* Actions globales */}
          <div className="flex items-center gap-2 shrink-0">
            <button
              onClick={() => handleBulkReview("REJECT")}
              disabled={isLoading}
              className="h-8 px-3 text-xs font-medium rounded-lg border border-red-500/25 bg-red-500/10 text-red-300 hover:bg-red-500/20 transition-colors flex items-center gap-1.5 disabled:opacity-50"
            >
              <FaXmark className="w-3 h-3" />
              Tout rejeter
            </button>
            <button
              onClick={() => handleBulkReview("ACCEPT")}
              disabled={isLoading}
              className="h-8 px-3 text-xs font-medium rounded-lg border border-emerald-500/25 bg-emerald-500/10 text-emerald-300 hover:bg-emerald-500/20 transition-colors flex items-center gap-1.5 disabled:opacity-50"
            >
              <FaCheckDouble className="w-3 h-3" />
              Tout accepter
            </button>
            <button
              onClick={() => setExpanded((v) => !v)}
              className="w-8 h-8 rounded-lg border border-white/8 bg-white/3 hover:bg-white/8 text-zinc-500 hover:text-zinc-300 flex items-center justify-center transition-colors"
            >
              {expanded ? <FaChevronUp className="w-3 h-3" /> : <FaChevronDown className="w-3 h-3" />}
            </button>
          </div>
        </div>

        {/* Liste des demandes */}
        {expanded && (
          <div className="px-5 pb-4 space-y-2">
            <div className="h-px bg-white/5 mb-3" />
            {requests.map((req, idx) => (
              <div
                key={req.id}
                className="flex items-center gap-3 px-4 py-3 rounded-xl border border-white/6 bg-white/2 hover:bg-white/4 transition-colors group"
              >
                {/* Numéro */}
                <span className="text-xs text-zinc-700 font-mono w-4 shrink-0">
                  {String(idx + 1).padStart(2, "0")}
                </span>

                <Avatar name={req.agentName} id={req.agentId} size="sm" />

                <div className="flex-1 min-w-0">
                  <div className="flex items-center gap-2">
                    <span className="text-sm font-medium text-zinc-200">
                      {req.agentName}
                    </span>
                    <span className="text-zinc-700">·</span>
                    <span className="text-xs text-zinc-600">{formatDate(req.requestedAt)}</span>
                  </div>
                  <div className="flex items-center gap-2 mt-0.5">
                    <span className="text-xs text-zinc-500">Demande d'accès à</span>
                    <span className="font-mono text-xs bg-amber-500/10 border border-amber-500/20 text-amber-300 px-1.5 py-0.5 rounded">
                      {req.formCode}
                    </span>
                    <span className="text-xs text-zinc-500 truncate">{req.formName}</span>
                  </div>
                </div>

                {/* Actions */}
                <div className="flex gap-2 shrink-0 opacity-60 group-hover:opacity-100 transition-opacity">
                  <button
                    onClick={() => handleReview(req.id, "REJECT")}
                    disabled={processingId === req.id || isLoading}
                    className="h-7 px-2.5 text-xs rounded-lg border border-red-500/20 bg-red-500/8 text-red-300 hover:bg-red-500/18 transition-colors flex items-center gap-1 disabled:opacity-40"
                  >
                    <FaXmark className="w-2.5 h-2.5" />
                    Rejeter
                  </button>
                  <button
                    onClick={() => handleReview(req.id, "ACCEPT")}
                    disabled={processingId === req.id || isLoading}
                    className="h-7 px-2.5 text-xs rounded-lg border border-emerald-500/20 bg-emerald-500/8 text-emerald-300 hover:bg-emerald-500/18 transition-colors flex items-center gap-1 disabled:opacity-40"
                  >
                    {processingId === req.id ? (
                      <span className="w-2.5 h-2.5 border border-emerald-400/50 border-t-emerald-400 rounded-full animate-spin" />
                    ) : (
                      <FaCheck className="w-2.5 h-2.5" />
                    )}
                    Accepter
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}
