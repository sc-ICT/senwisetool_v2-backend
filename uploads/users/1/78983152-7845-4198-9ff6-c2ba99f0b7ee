"use client";

import { useEffect, useState } from "react";
import { Agent } from "../types/agents.types";
import { inputCls } from "./agents.constants";
import Button from "@/ui/components/buttons/button";
import { FaPlus, FaTrash, FaUserPlus } from "react-icons/fa6";

interface AgentModalProps {
  agent: Partial<Agent> | null;
  isLoading: boolean;
  onClose: () => void;
  onSave: (data: { agentNames: string[] }) => void;
}

export function AgentModal({ agent, isLoading, onClose, onSave }: AgentModalProps) {
  const isEdit = !!agent?.id;
  const [names, setNames] = useState<string[]>([""]);

  useEffect(() => {
    setNames(agent?.agentName ? [agent.agentName] : [""]);
  }, [agent]);

  const add = () => setNames((p) => [...p, ""]);
  const remove = (i: number) =>
    setNames((p) => (p.length === 1 ? [""] : p.filter((_, idx) => idx !== i)));
  const update = (i: number, val: string) =>
    setNames((p) => p.map((n, idx) => (idx === i ? val : n)));

  const handleSubmit = () => {
    const valid = names.map((n) => n.trim()).filter((n) => n.length > 0);
    if (!valid.length) return;
    onSave({ agentNames: valid });
  };

  return (
    <div
      className="fixed inset-0 bg-black/60 flex items-center justify-center z-50 backdrop-blur-sm"
      onClick={onClose}
    >
      <div
        className="bg-[#0d1b35] border border-white/10 rounded-2xl w-[480px] max-w-[92vw] flex flex-col max-h-[85vh] shadow-2xl shadow-black/50"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Header */}
        <div className="flex items-center gap-3 px-6 py-5 border-b border-white/6 shrink-0">
          <div className="w-9 h-9 rounded-xl bg-blue-500/15 border border-blue-500/20 flex items-center justify-center">
            <FaUserPlus className="w-3.5 h-3.5 text-blue-400" />
          </div>
          <div className="flex-1">
            <h2 className="text-sm font-semibold text-zinc-100">
              {isEdit ? "Modifier l'agent" : "Ajouter des agents"}
            </h2>
            {!isEdit && (
              <p className="text-xs text-zinc-600 mt-0.5">
                Vous pouvez ajouter plusieurs agents à la fois
              </p>
            )}
          </div>
          <button
            onClick={onClose}
            disabled={isLoading}
            className="w-7 h-7 rounded-lg border border-white/8 text-zinc-500 hover:text-zinc-300 hover:bg-white/5 flex items-center justify-center transition-colors text-sm"
          >
            ✕
          </button>
        </div>

        {/* Body */}
        <div className="flex-1 overflow-y-auto px-6 py-5 space-y-2">
          <label className="block text-xs text-zinc-500 mb-3">
            {isEdit ? "Nom de l'agent" : "Nom des agents"}
          </label>

          {names.map((name, i) => (
            <div key={i} className="flex items-center gap-2">
              {!isEdit && (
                <span className="text-xs text-zinc-700 font-mono w-5 shrink-0 text-right">
                  {i + 1}
                </span>
              )}
              <input
                className={inputCls}
                placeholder={isEdit ? "Nom de l'agent" : `Agent #${i + 1}`}
                value={name}
                onChange={(e) => update(i, e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === "Enter" && !isEdit) add();
                }}
                autoFocus={i === names.length - 1}
              />
              {!isEdit && (
                <button
                  onClick={() => remove(i)}
                  className="w-9 h-9 shrink-0 border border-white/8 text-zinc-600 hover:text-rose-400 hover:bg-rose-500/10 hover:border-rose-500/20 rounded-lg flex items-center justify-center transition-colors"
                >
                  <FaTrash className="w-3 h-3" />
                </button>
              )}
            </div>
          ))}

          {!isEdit && (
            <button
              onClick={add}
              className="mt-2 flex items-center gap-2 text-xs text-blue-400 hover:text-blue-300 font-medium transition-colors py-1"
            >
              <div className="w-5 h-5 rounded-md border border-blue-500/30 bg-blue-500/10 flex items-center justify-center">
                <FaPlus className="w-2.5 h-2.5" />
              </div>
              Ajouter un autre agent
            </button>
          )}
        </div>

        {/* Footer */}
        <div className="flex justify-end gap-2 px-6 py-4 border-t border-white/6 shrink-0">
          <button
            onClick={onClose}
            disabled={isLoading}
            className="h-9 px-4 text-sm rounded-xl border border-white/10 text-zinc-400 hover:bg-white/5 transition-colors"
          >
            Annuler
          </button>
          <Button
            onClick={handleSubmit}
            isLoading={isLoading}
            className="h-9 px-5 text-sm rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-500 transition-colors"
          >
            {isEdit ? "Enregistrer" : `Créer ${names.filter((n) => n.trim()).length || ""} agent${names.filter((n) => n.trim()).length > 1 ? "s" : ""}`}
          </Button>
        </div>
      </div>
    </div>
  );
}
