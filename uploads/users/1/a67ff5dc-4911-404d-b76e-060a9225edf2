from pydantic import BaseModel, ConfigDict, Field

from app.schemas.form_builder.formulaire_question_config import FormulaireQuestionConfig


class FormulaireQuestionCreate(BaseModel):
    question_definition_id: int = Field(
        gt=0,
    )

    question_version_id: int = Field(
        gt=0,
    )

    config: FormulaireQuestionConfig = Field(
        default_factory=FormulaireQuestionConfig,
    )


class FormulaireQuestionUpdate(BaseModel):
    config: FormulaireQuestionConfig | None = None


class FormulaireQuestionOptionResponse(BaseModel):
    id: int
    value: str
    label: str
    position: int
    option_metadata: dict

    model_config = ConfigDict(
        from_attributes=True,
    )


class FormulaireQuestionResponse(BaseModel):
    id: int
    formulaire_id: int
    section_id: int
    question_definition_id: int
    question_version_id: int
    position: int
    config: dict

    question_code: str
    question_name: str

    version_number: int
    version_label: str
    question_type: str

    options: list[FormulaireQuestionOptionResponse]

    model_config = ConfigDict(
        from_attributes=True,
    )


class FormulaireQuestionListResponse(BaseModel):
    items: list[FormulaireQuestionResponse]
    count: int


class FormulaireQuestionReorder(BaseModel):
    ordered_question_ids: list[int] = Field(
        min_length=1,
    )
