from fastapi import APIRouter, Depends, HTTPException, status

from app.dependencies import (
    CurrentUser,
    get_formulaire_section_service,
)
from app.models.user import User
from app.schemas.common import ApiResponse, ok
from app.schemas.form_builder.formulaire_section import (
    FormulaireSectionCreate,
    FormulaireSectionListResponse,
    FormulaireSectionReorder,
    FormulaireSectionResponse,
    FormulaireSectionUpdate,
)
from app.services.form_builder.formulaire_section import (
    FormulaireSectionService,
)

router = APIRouter(
    prefix="/formulaires/{formulaire_id}/sections",
    tags=["Formulaire Sections"],
)


@router.post(
    "",
    response_model=ApiResponse[FormulaireSectionResponse],
    status_code=status.HTTP_201_CREATED,
)
async def create_formulaire_section(
    formulaire_id: int,
    data: FormulaireSectionCreate,
    service: FormulaireSectionService = Depends(
        get_formulaire_section_service,
    ),
    user: User = CurrentUser,
):
    try:
        section = await service.create(
            formulaire_id=formulaire_id,
            user_id=user.id,
            data=data,
        )

        return ok(
            message="Section créée avec succès.",
            data=FormulaireSectionResponse.model_validate(
                section,
            ),
        )

    except ValueError as exc:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=str(exc),
        ) from exc


@router.get("", response_model=ApiResponse[FormulaireSectionListResponse])
async def list_formulaire_sections(
    formulaire_id: int,
    service: FormulaireSectionService = Depends(
        get_formulaire_section_service,
    ),
    user: User = CurrentUser,
):
    try:
        sections = await service.list(
            formulaire_id=formulaire_id,
            user_id=user.id,
        )

        return ok(
            message="Sections récupérées avec succès.",
            data=FormulaireSectionListResponse(
                items=[
                    FormulaireSectionResponse.model_validate(
                        section,
                    )
                    for section in sections
                ],
                count=len(sections),
            ),
        )

    except ValueError as exc:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=str(exc),
        ) from exc


@router.patch("/reorder", response_model=ApiResponse[FormulaireSectionListResponse])
