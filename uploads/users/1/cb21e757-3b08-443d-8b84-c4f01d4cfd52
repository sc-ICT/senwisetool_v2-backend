from __future__ import annotations

from copy import deepcopy
from typing import BinaryIO

from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.models.enums import FileNodeType
from app.models.form_builder.enums import FormulaireStatus
from app.models.form_builder.formulaire_definition import (
    FormulaireDefinition,
)
from app.schemas.form_builder.formulaire_definition import (
    FormulaireDefinitionCreate,
    FormulaireDefinitionUpdate,
)
from app.services.file_system import FileNotFoundError as FileSystemNotFoundError
from app.services.file_system import (
    FileSystemService,
)
from app.services.form_builder.formulaire_code import generate_formulaire_code
from app.services.form_builder.formulaire_defaults import (
    DEFAULT_FORMULAIRE_GLOBAL_CONFIG,
    merge_formulaire_global_config,
)


class FormulaireDefinitionService:
    def __init__(
        self,
        session: AsyncSession,
        file_system: FileSystemService,
    ) -> None:
        self.session = session
        self.file_system = file_system

    async def create(
        self,
        *,
        user_id: int,
        data: FormulaireDefinitionCreate,
    ) -> FormulaireDefinition:
        name = data.name.strip()
        formulaire_type = data.formulaire_type.strip()

        if not name:
            raise ValueError("Le nom du formulaire est obligatoire.")

        if not formulaire_type:
            raise ValueError("Le type du formulaire est obligatoire.")

        code = generate_formulaire_code(user_id)

        formulaire = FormulaireDefinition(
            code=code,
            name=name,
            description=(
                data.description.strip() if data.description and data.description.strip() else None
            ),
            formulaire_type=formulaire_type,
            status=FormulaireStatus.DRAFT,
            global_config=deepcopy(
                DEFAULT_FORMULAIRE_GLOBAL_CONFIG,
            ),
            created_by=user_id,
        )

        self.session.add(formulaire)

        await self.session.flush()

        await self.ensure_formulaire_folder(
            formulaire=formulaire,
            user_id=user_id,
        )

        return formulaire

    async def ensure_formulaire_folder(
        self,
        *,
        formulaire: FormulaireDefinition,
        user_id: int,
    ):
        """
        Retourne le dossier associé au formulaire.

        Si formulaire_folder_id existe et que le dossier existe encore,
        il est réutilisé.

        Si la référence existe mais que le dossier a été supprimé,
        un nouveau dossier est créé et la référence est mise à jour.
        """

        if formulaire.formulaire_folder_id is not None:
            try:
                folder = await self.file_system.get_node(
                    user_id=user_id,
                    node_id=formulaire.formulaire_folder_id,
                )

                if folder.type == FileNodeType.FOLDER:
                    return folder

            except FileSystemNotFoundError:
                pass

        folder = await self.file_system.create_folder(
            user_id=user_id,
            name=formulaire.code,
        )

        formulaire.formulaire_folder_id = folder.id

        await self.session.flush()

        return folder

    async def _ensure_attachments_enabled(
        self,
        *,
        formulaire: FormulaireDefinition,
    ) -> None:
        config = formulaire.global_config or {}

        attachments = config.get("attachments")

        if not isinstance(attachments, dict):
            raise ValueError("La configuration des fichiers attachés est invalide.")

        if attachments.get("enabled") is not True:
            raise PermissionError("Les fichiers attachés ne sont pas activés pour ce formulaire.")

    async def list(
        self,
        *,
        user_id: int,
        include_archived: bool = False,
    ) -> list[FormulaireDefinition]:
        statement = (
            select(FormulaireDefinition)
            .where(
                FormulaireDefinition.created_by == user_id,
            )
            .order_by(
                FormulaireDefinition.name.asc(),
            )
        )

        if not include_archived:
            statement = statement.where(
                FormulaireDefinition.status != FormulaireStatus.ARCHIVED,
            )

        result = await self.session.execute(
            statement,
        )

        return list(result.scalars().all())

    async def get(
        self,
        *,
        formulaire_id: int,
        user_id: int,
    ) -> FormulaireDefinition | None:
        result = await self.session.execute(
            select(FormulaireDefinition).where(
                FormulaireDefinition.id == formulaire_id,
                FormulaireDefinition.created_by == user_id,
            )
        )

        return result.scalar_one_or_none()

    async def update(
        self,
        *,
        formulaire_id: int,
        user_id: int,
        data: FormulaireDefinitionUpdate,
    ) -> FormulaireDefinition:
        formulaire = await self.get(
            formulaire_id=formulaire_id,
            user_id=user_id,
        )

        if formulaire is None:
            raise ValueError("Formulaire introuvable.")

        if data.name is not None:
            name = data.name.strip()

            if not name:
                raise ValueError("Le nom du formulaire est obligatoire.")

            formulaire.name = name

        if data.description is not None:
            formulaire.description = data.description.strip() or None

        if data.formulaire_type is not None:
            formulaire_type = data.formulaire_type.strip()

            if not formulaire_type:
                raise ValueError("Le type du formulaire est obligatoire.")

            formulaire.formulaire_type = formulaire_type

        if data.global_config is not None:
            formulaire.global_config = merge_formulaire_global_config(
                formulaire.global_config,
                data.global_config,
            )

        if data.status is not None:
            formulaire.status = data.status

        await self.session.flush()

        return formulaire

    async def archive(
        self,
        *,
        formulaire_id: int,
        user_id: int,
    ) -> FormulaireDefinition:
        formulaire = await self.get(
            formulaire_id=formulaire_id,
            user_id=user_id,
        )

        if formulaire is None:
            raise ValueError("Formulaire introuvable.")

        formulaire.status = FormulaireStatus.ARCHIVED

        await self.session.flush()

        return formulaire

    async def delete(
        self,
        *,
        formulaire_id: int,
        user_id: int,
    ) -> None:
        formulaire = await self.get(
            formulaire_id=formulaire_id,
            user_id=user_id,
        )

        if formulaire is None:
            raise ValueError("Formulaire introuvable.")

        # --------------------------------------------------------
        # 1. Supprimer le dossier du formulaire et tout son contenu
        # --------------------------------------------------------

        if formulaire.formulaire_folder_id is not None:
            try:
                await self.file_system.delete(
                    user_id=user_id,
                    node_id=formulaire.formulaire_folder_id,
                )
            except FileSystemNotFoundError:
                # Le dossier a déjà été supprimé.
                pass

        # --------------------------------------------------------
        # 2. Supprimer le formulaire et ses données associées
        # --------------------------------------------------------

        await self.session.delete(formulaire)

        await self.session.flush()

    async def list_formulaire_files(
        self,
        *,
        formulaire_id: int,
        user_id: int,
    ):
        formulaire = await self.get(
            formulaire_id=formulaire_id,
            user_id=user_id,
        )

        if formulaire is None:
            raise ValueError("Formulaire introuvable.")

        await self._ensure_attachments_enabled(
            formulaire=formulaire,
        )

        folder = await self.ensure_formulaire_folder(
            formulaire=formulaire,
            user_id=user_id,
        )

        return await self.file_system.list_children(
            user_id=user_id,
            parent_id=folder.id,
        )

    async def upload_formulaire_file(
        self,
        *,
        formulaire_id: int,
        user_id: int,
        name: str,
        source: BinaryIO,
        mime_type: str | None = None,
        extension: str | None = None,
    ):
        formulaire = await self.get(
            formulaire_id=formulaire_id,
            user_id=user_id,
        )

        if formulaire is None:
            raise ValueError("Formulaire introuvable.")

        await self._ensure_attachments_enabled(
            formulaire=formulaire,
        )

        folder = await self.ensure_formulaire_folder(
            formulaire=formulaire,
            user_id=user_id,
        )

        return await self.file_system.create_file(
            user_id=user_id,
            name=name,
            source=source,
            parent_id=folder.id,
            mime_type=mime_type,
            extension=extension,
        )

    async def delete_formulaire_file(
        self,
        *,
        formulaire_id: int,
        file_id: int,
        user_id: int,
    ) -> None:
        formulaire = await self.get(
            formulaire_id=formulaire_id,
            user_id=user_id,
        )

        if formulaire is None:
            raise ValueError("Formulaire introuvable.")

        await self._ensure_attachments_enabled(
            formulaire=formulaire,
        )

        folder = await self.ensure_formulaire_folder(
            formulaire=formulaire,
            user_id=user_id,
        )

        file_node = await self.file_system.get_node(
            user_id=user_id,
            node_id=file_id,
        )

        if file_node.parent_id != folder.id:
            raise PermissionError("Ce fichier n'appartient pas à ce formulaire.")

        if file_node.type != FileNodeType.FILE:
            raise ValueError("L'élément indiqué n'est pas un fichier.")

        await self.file_system.delete(
            user_id=user_id,
            node_id=file_id,
        )
