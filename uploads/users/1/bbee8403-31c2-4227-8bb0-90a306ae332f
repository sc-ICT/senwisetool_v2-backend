from pathlib import Path

from fastapi import APIRouter, Depends, File, HTTPException, UploadFile, status

from app.dependencies import (
    CurrentUser,
    get_formulaire_definition_service,
)
from app.models.user import User
from app.schemas.common import ApiResponse, ok
from app.schemas.file_system import FileNodeResponse
from app.schemas.form_builder.formulaire_definition import (
    FormulaireDefinitionCreate,
    FormulaireDefinitionListResponse,
    FormulaireDefinitionResponse,
    FormulaireDefinitionUpdate,
)
from app.schemas.form_builder.formulaire_files import FormulaireFilesResponse
from app.services.file_system import FileAlreadyExistsError, InvalidFileOperationError
from app.services.form_builder.formulaire_defaults import normalize_formulaire_global_config
from app.services.form_builder.formulaire_definition import (
    FormulaireDefinitionService,
)

router = APIRouter(
    prefix="/formulaires",
    tags=["Formulaires"],
)


@router.post(
    "",
    response_model=ApiResponse[FormulaireDefinitionResponse],
    status_code=status.HTTP_201_CREATED,
)
async def create_formulaire(
    data: FormulaireDefinitionCreate,
    service: FormulaireDefinitionService = Depends(
        get_formulaire_definition_service,
    ),
    user: User = CurrentUser,
):
    try:
        formulaire = await service.create(
            user_id=user.id,
            data=data,
        )

        return ok(
            message="Formulaire créé avec succès.",
            data=FormulaireDefinitionResponse.model_validate(
                formulaire,
            ),
        )

    except ValueError as exc:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=str(exc),
        ) from exc


@router.get(
    "",
    response_model=ApiResponse[FormulaireDefinitionListResponse],
)
async def list_formulaires(
    include_archived: bool = False,
    service: FormulaireDefinitionService = Depends(
        get_formulaire_definition_service,
    ),
    user: User = CurrentUser,
):
    formulaires = await service.list(
        user_id=user.id,
        include_archived=include_archived,
    )

    return ok(
        message="Formulaires récupérés avec succès.",
        data=FormulaireDefinitionListResponse(
            items=[
                FormulaireDefinitionResponse.model_validate(
                    formulaire,
                )
                for formulaire in formulaires
            ],
            count=len(formulaires),
        ),
    )


@router.get(
    "/{formulaire_id}",
    response_model=ApiResponse[FormulaireDefinitionResponse],
)
async def get_formulaire(
    formulaire_id: int,
    service: FormulaireDefinitionService = Depends(
        get_formulaire_definition_service,
    ),
    user: User = CurrentUser,
):
    formulaire = await service.get(
        formulaire_id=formulaire_id,
        user_id=user.id,
    )

    if formulaire is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Formulaire introuvable.",
        )

    formulaire.global_config = normalize_formulaire_global_config(formulaire.global_config)

    return ok(
        message="Formulaire récupéré avec succès.",
        data=FormulaireDefinitionResponse.model_validate(
            formulaire,
        ),
    )


