"use client";

import { Agent } from "../types/agents.types";
import {
  Avatar,
  EmptyState,
  FormTag,
  SortIcon,
  StatusBadge,
  TableSkeleton,
} from "./agents.atoms";
import { formatDate } from "./agents.constants";
import {
  FaClipboardList,
  FaPenToSquare,
  FaTrash,
} from "react-icons/fa6";

interface AgentsTableProps {
  agents: Agent[];
  isLoading: boolean;
  selected: Set<number>;
  onToggleSelect: (id: number) => void;
  onToggleAll: (checked: boolean) => void;
  sortBy: "name" | "date" | "forms";
  sortDir: 1 | -1;
  onSort: (col: "name" | "date" | "forms") => void;
  onEdit: (agent: Agent) => void;
  onDelete: (ids: number[]) => void;
  onManageForms: (agentId: number) => void;
}

const COL_HEADERS = [
  { key: "name" as const, label: "Agent", sortable: true },
  { key: "status" as const, label: "Statut", sortable: false },
  { key: "date" as const, label: "Créé le", sortable: true },
  { key: "forms" as const, label: "Formulaires assignés", sortable: true },
];

export function AgentsTable({
  agents,
  isLoading,
  selected,
  onToggleSelect,
  onToggleAll,
  sortBy,
  sortDir,
  onSort,
  onEdit,
  onDelete,
  onManageForms,
}: AgentsTableProps) {
  const allSelected = agents.length > 0 && agents.every((a) => selected.has(a.id));
  const someSelected = agents.some((a) => selected.has(a.id));

  return (
    <div className="rounded-2xl border border-white/8 bg-[#0a1628] overflow-hidden">
      <table className="w-full text-sm" style={{ tableLayout: "fixed" }}>
        <colgroup>
          <col className="w-11" />
          <col className="w-52" />
          <col className="w-28" />
          <col className="w-28" />
          <col />
          <col className="w-28" />
        </colgroup>

        <thead>
          <tr className="border-b border-white/6 bg-white/2">
            <th className="px-4 py-3">
              <input
                type="checkbox"
                className="w-3.5 h-3.5 rounded accent-blue-500 cursor-pointer"
                checked={allSelected}
                ref={(el) => {
                  if (el) el.indeterminate = someSelected && !allSelected;
                }}
                onChange={(e) => onToggleAll(e.target.checked)}
              />
            </th>

            {COL_HEADERS.map(({ key, label, sortable }) => (
              <th
                key={key}
                className={`px-4 py-3 text-left text-xs font-medium text-zinc-600 uppercase tracking-wider ${sortable ? "cursor-pointer hover:text-zinc-400 select-none" : ""}`}
                onClick={sortable ? () => onSort(key === "status" ? "name" : (key as "name" | "date" | "forms")) : undefined}
              >
                {label}
                {sortable && (
                  <SortIcon
                    active={sortBy === (key === "status" ? "name" : key)}
                    dir={sortDir}
                  />
                )}
              </th>
            ))}

            <th className="px-4 py-3 text-left text-xs font-medium text-zinc-600 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>

        <tbody>
          {isLoading ? (
            <TableSkeleton rows={5} />
          ) : agents.length === 0 ? (
            <EmptyState message="Aucun agent trouvé" />
          ) : (
            agents.map((agent) => (
              <AgentRow
                key={agent.id}
                agent={agent}
                selected={selected.has(agent.id)}
                onToggle={() => onToggleSelect(agent.id)}
                onEdit={() => onEdit(agent)}
                onDelete={() => onDelete([agent.id])}
                onManageForms={() => onManageForms(agent.id)}
              />
            ))
          )}
        </tbody>
      </table>
    </div>
  );
}

// ─── Row ─────────────────────────────────────────────────────────────────────

function AgentRow({
  agent,
  selected,
  onToggle,
  onEdit,
  onDelete,
  onManageForms,
}: {
  agent: Agent;
  selected: boolean;
  onToggle: () => void;
  onEdit: () => void;
  onDelete: () => void;
  onManageForms: () => void;
}) {
  return (
    <tr
      className={`border-b border-white/5 last:border-0 cursor-pointer group transition-colors ${
        selected
          ? "bg-blue-500/6 hover:bg-blue-500/10"
          : "hover:bg-white/2"
      }`}
      onClick={onToggle}
    >
      {/* Checkbox */}
      <td className="px-4 py-3.5" onClick={(e) => e.stopPropagation()}>
        <input
          type="checkbox"
          className="w-3.5 h-3.5 rounded accent-blue-500 cursor-pointer"
          checked={selected}
          onChange={onToggle}
        />
      </td>

      {/* Agent */}
      <td className="px-4 py-3.5">
        <div className="flex items-center gap-2.5">
          <Avatar name={agent.agentName} id={agent.id} />
          <div className="min-w-0">
            <p className="font-medium text-zinc-100 text-sm truncate">
              {agent.agentName}
            </p>
            <p className="text-[11px] text-zinc-600 font-mono truncate">
              {agent.token}
            </p>
          </div>
        </div>
      </td>

      {/* Statut */}
      <td className="px-4 py-3.5">
        <StatusBadge status={agent.status} />
      </td>

      {/* Date */}
      <td className="px-4 py-3.5 text-xs text-zinc-600">
        {formatDate(agent.createdAt)}
      </td>

      {/* Formulaires */}
      <td className="px-4 py-3.5">
        <div className="flex flex-wrap gap-1">
          {agent.forms.length === 0 ? (
            <span className="text-xs text-zinc-700 italic">Aucun formulaire</span>
          ) : (
            agent.forms.map((f) => <FormTag key={f.id} form={f} />)
          )}
        </div>
      </td>

      {/* Actions */}
      <td className="px-4 py-3.5" onClick={(e) => e.stopPropagation()}>
        <div className="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
          <ActionBtn
            title="Gérer les formulaires"
            icon={<FaClipboardList className="w-3 h-3" />}
            onClick={onManageForms}
            hoverCls="hover:text-blue-400 hover:bg-blue-500/10 hover:border-blue-500/20"
          />
          <ActionBtn
            title="Modifier"
            icon={<FaPenToSquare className="w-3 h-3" />}
            onClick={onEdit}
            hoverCls="hover:text-zinc-200 hover:bg-white/8 hover:border-white/15"
          />
          <ActionBtn
            title="Supprimer"
            icon={<FaTrash className="w-3 h-3" />}
            onClick={onDelete}
            hoverCls="hover:text-red-300 hover:bg-red-500/10 hover:border-red-500/20"
          />
        </div>
      </td>
    </tr>
  );
}

function ActionBtn({
  title,
  icon,
  onClick,
  hoverCls,
}: {
  title: string;
  icon: React.ReactNode;
  onClick: () => void;
  hoverCls: string;
}) {
  return (
    <button
      title={title}
      onClick={onClick}
      className={`w-7 h-7 rounded-md border border-transparent text-zinc-600 flex items-center justify-center transition-colors ${hoverCls}`}
    >
      {icon}
    </button>
  );
}
